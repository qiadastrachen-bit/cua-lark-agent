# ========== hybrid：DeepSeek 文本 + 第三方视觉 API ==========
VLM_PROVIDER=hybrid

# DeepSeek（纯文本：--instruction 解析）
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# --- 视觉 API（三选一，填 VISION_* 即可）---

# 方案 A：阿里云百炼 DashScope（推荐，稳定，中文桌面 UI 强）
# 注册: https://bailian.console.aliyun.com/ → 开通百炼 → 创建 API Key（需实名）
# VISION_PROVIDER=dashscope
# VISION_API_KEY=sk-...
# VISION_MODEL=qwen3-vl-plus
# VISION_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# 预算紧可用: qwen3-vl-flash；要更高精度: qwen-vl-max

# 方案 B：智谱 AI GLM-4V
# 注册: https://open.bigmodel.cn/
# VISION_PROVIDER=zhipu
# VISION_API_KEY=...
# VISION_MODEL=glm-4v-plus
# VISION_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# 方案 C：硅基流动 SiliconFlow（平台仍在，但 Qwen2.5-VL 已下线，需实名）
# 注册: https://cloud.siliconflow.cn/account/ak
# VISION_PROVIDER=siliconflow
# VISION_API_KEY=sk-...
# VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct
# VISION_API_URL=https://api.siliconflow.cn/v1/chat/completions

# 旧火山方舟变量名仍兼容（等价于 VISION_*）:
# VOLC_API_KEY= / VOLC_ENDPOINT_ID= / VOLC_API_URL=

VLM_TIMEOUT=30
VLM_RETRIES=2
VLM_DISABLE_THINKING=true
USE_FIXED_COORDS=false
ENABLE_STATE_CHECK=true
STRICT_STATE_CHECK=false
STEP_DELAY_SEC=30
CASE_DELAY_SEC=90
